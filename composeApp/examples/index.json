            "great/all3.json",
            "great/all4.json",
            "great/all5.json",
            "great/all6.json",
            "great/all7.json",
            "great/all8.json"
          ]
        },
        {
          "id": "intersecting-digonfree",
          "title": "Intersecting, digon-free",
